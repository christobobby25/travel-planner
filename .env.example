# Copy to .env and fill in. Never commit .env.
AWS_REGION=us-east-1
# Any Bedrock model with tool use that you've enabled in the Bedrock console (use the inference profile ID)
BEDROCK_MODEL_ID=

# Duffel: free account, use a TEST token (starts with duffel_test_)
DUFFEL_ACCESS_TOKEN=

# AccuWeather: free trial key from developer.accuweather.com (MCP works on trial)
ACCUWEATHER_API_KEY=

# Hotels: LiteAPI hosted MCP. Free signup at dashboard.liteapi.travel, use the SANDBOX key (sand_...)
LITEAPI_API_KEY=
# Optional override if you switch providers later
HOTEL_MCP_URL=
HOTEL_MCP_HEADERS={}

# Only in AWS: name of the Secrets Manager secret holding the keys above
TRAVEL_SECRET_ID=

# Streamlit UI calls the deployed agent when set (from `agentcore status`); leave empty for local mode
AGENTCORE_RUNTIME_ARN=

# Public API (infra/ stack outputs). When both are set, the Streamlit UI uses the API instead.
TRAVEL_API_URL=
TRAVEL_API_KEY=
